# Local mode (recommended for a 16 GB NVIDIA GPU)
GENERATION_PROVIDER=local
LOCAL_FLUX_URL=http://127.0.0.1:8188
LOCAL_FLUX_MODEL=black-forest-labs/FLUX.2-klein-4B
FLUX_BASE_SEED=481976
LOCAL_FLUX_STEPS=4
LOCAL_FLUX_REFERENCE_EDGE=768
LOCAL_FLUX_DEFAULT_REFERENCES=5
LOCAL_FLUX_USER_REFERENCES=3

# Optional cloud fallback
FAL_KEY=your_fal_api_key
FAL_FLUX_MODEL=fal-ai/flux/dev/image-to-image

# Voz opcional para la pista de narración del timeline local
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
NEXT_PUBLIC_TIMELINE_URL=http://localhost:5173
